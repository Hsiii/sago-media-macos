#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
swift build --package-path "$root" -c release

bundle="$root/.build/Sago Media.app"
mkdir -p "$bundle/Contents/MacOS"
cp "$root/.build/release/SagoMedia" "$bundle/Contents/MacOS/SagoMedia"
printf '%s\n' \
  '<?xml version="1.0" encoding="UTF-8"?>' \
  '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
  '<plist version="1.0"><dict>' \
  '<key>CFBundleExecutable</key><string>SagoMedia</string>' \
  '<key>CFBundleIdentifier</key><string>dev.hsichen.SagoMedia</string>' \
  '<key>CFBundleName</key><string>Sago Media</string>' \
  '<key>CFBundlePackageType</key><string>APPL</string>' \
  '<key>CFBundleShortVersionString</key><string>0.1.0</string>' \
  '<key>LSMinimumSystemVersion</key><string>14.0</string>' \
  '<key>LSUIElement</key><true/>' \
  '</dict></plist>' \
  >"$bundle/Contents/Info.plist"

printf '%s\n' "$bundle"

identity="${SAGO_MEDIA_CODESIGN_IDENTITY:--}"
codesign --force --deep --options runtime --sign "$identity" "$bundle"
